---
/**
 * Fig. 0: Where we work. The six capability areas in plan view.
 * Highlighted areas and bridges show EXAMPLE engagement configurations
 * (one area, two, several); the state is switched by src/scripts/page.ts.
 * Without JS, or with reduced motion, the last state is shown statically.
 */
import { hero, pillars } from "../content/site";
import { chainBridges, zones, type Layout } from "../lib/areas";

interface Props {
  variant: Layout;
}
const { variant } = Astro.props;

const W = variant === "wide" ? 600 : 360;
const H = variant === "wide" ? 384 : 560;
const GAP = variant === "wide" ? 12 : 10;
const list = zones(variant, W, H, GAP);
const initial = hero.states[1]!.id;
const stateBridges = hero.states.map((s) => ({
  id: s.id,
  lines: chainBridges(list, s.areas, GAP),
}));
const inStates = (no: string) =>
  hero.states
    .filter((s) => s.areas.includes(no as never))
    .map((s) => s.id)
    .join(" ");
---

<svg
  class:list={["amap", `amap--${variant}`]}
  viewBox={`-2 -2 ${W + 4} ${H + 4}`}
  aria-hidden="true"
  focusable="false"
  data-state={initial}
  data-cycle-target
>
  {list.map((z) => {
    const p = pillars.find((pp) => pp.no === z.no)!;
    return (
      <g class="amap__zone" data-in={inStates(z.no)}>
        <rect x={z.x} y={z.y} width={z.w} height={z.h} class="amap__rect" />
        <text x={z.x + 14} y={z.y + 24} class="amap__no">
          {z.no}
        </text>
        {p.lines.map((ln, i) => (
          <text x={z.x + 14} y={z.y + 46 + i * 16} class="amap__name">
            {ln.toUpperCase()}
          </text>
        ))}
        {p.keys.map((k, i) => (
          <text x={z.x + 14} y={z.y + z.h - 16 - (p.keys.length - 1 - i) * 16} class="amap__key">
            {k}
          </text>
        ))}
      </g>
    );
  })}
  {stateBridges.map((s) => (
    <g class="amap__bridges" data-for={s.id}>
      {s.lines.map((l) => (
        <>
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} class="amap__bridge" />
          <rect x={l.x1 - 3} y={l.y1 - 3} width="6" height="6" class="amap__joint" />
          <rect x={l.x2 - 3} y={l.y2 - 3} width="6" height="6" class="amap__joint" />
        </>
      ))}
    </g>
  ))}
</svg>

<style>
  .amap {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .amap__rect {
    fill: var(--signal);
    fill-opacity: 0;
    stroke: var(--rule-strong);
    stroke-width: 1;
    transition:
      fill-opacity var(--t-med) var(--ease-out),
      stroke var(--t-med) var(--ease-out);
  }
  .amap__no {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--graphite);
    transition: fill var(--t-med) var(--ease-out);
  }
  .amap__name {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.07em;
    fill: var(--ink);
  }
  .amap__key {
    font-family: var(--font-text);
    font-size: 12.5px;
    fill: var(--graphite);
  }
  .amap--narrow .amap__name {
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  .amap--narrow .amap__key {
    font-size: 12px;
  }

  .amap__bridges {
    opacity: 0;
    transition: opacity var(--t-med) var(--ease-out);
  }
  .amap__bridge {
    stroke: var(--signal);
    stroke-width: 2.5;
  }
  .amap__joint {
    fill: var(--signal);
  }

  /* Active state: areas in the current example configuration */
  .amap[data-state="a"] [data-in~="a"] .amap__rect,
  .amap[data-state="b"] [data-in~="b"] .amap__rect,
  .amap[data-state="c"] [data-in~="c"] .amap__rect {
    fill-opacity: 0.07;
    stroke: var(--signal);
    stroke-width: 1.5;
  }
  .amap[data-state="a"] [data-in~="a"] .amap__no,
  .amap[data-state="b"] [data-in~="b"] .amap__no,
  .amap[data-state="c"] [data-in~="c"] .amap__no {
    fill: var(--signal-text);
  }
  .amap[data-state="a"] [data-for="a"],
  .amap[data-state="b"] [data-for="b"],
  .amap[data-state="c"] [data-for="c"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .amap__rect,
    .amap__no,
    .amap__bridges {
      transition: none;
    }
  }
</style>
