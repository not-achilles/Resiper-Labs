---
/**
 * Fig. 1: one illustrative cross-area scenario, drawn on the same plan view
 * as the hero. Wide screens only; the numbered list carries the same content.
 */
import { pillars, scenario } from "../content/site";
import { zones, zoneOf } from "../lib/areas";

const W = 1200;
const H = 500;
const GAP = 16;
const list = zones("wide", W, H, GAP);

// Marker positions: zone centre, except a second step in the same zone.
const seen = new Map<string, number>();
const marks = scenario.steps.map((s) => {
  const z = zoneOf(list, s.layer);
  const n = seen.get(s.layer) ?? 0;
  seen.set(s.layer, n + 1);
  // Zones in the last column carry the vertical run: keep it clear of their text.
  const lastCol = z.x + z.w >= W - 1;
  const x = n > 0 ? z.x + z.w * 0.2 : lastCol ? z.x + z.w * 0.8 : z.cx;
  return { ...s, x, y: z.cy, second: n > 0, flip: lastCol };
});
const d = marks
  .map((m, i) => `${i === 0 ? "M" : "L"}${m.x.toFixed(1)} ${m.y.toFixed(1)}`)
  .join(" ");
---

<svg
  class="scen"
  viewBox={`-2 -2 ${W + 4} ${H + 4}`}
  aria-hidden="true"
  focusable="false"
  data-draw
>
  {list.map((z) => {
    const p = pillars.find((pp) => pp.no === z.no)!;
    return (
      <g class="scen__zone">
        <rect x={z.x} y={z.y} width={z.w} height={z.h} class="scen__rect" />
        <text x={z.x + 18} y={z.y + 28} class="scen__name">
          <tspan class="scen__no">{z.no}</tspan>
          <tspan dx="10">{p.name.toUpperCase()}</tspan>
        </text>
        <text x={z.x + 18} y={z.y + z.h - 20} class="scen__key">
          {p.keys.join("  ·  ")}
        </text>
      </g>
    );
  })}

  <path d={d} class="scen__path" pathLength="1"></path>

  {marks.map((m, i) => (
    <g class="scen__step" style={`--n:${i}`}>
      <rect x={m.x - 12} y={m.y - 12} width="24" height="24" class="scen__mark" />
      <text x={m.x} y={m.y + 4.5} text-anchor="middle" class="scen__n">
        {m.no}
      </text>
      <text
        x={m.flip ? m.x - 20 : m.x + 20}
        y={m.second ? m.y + 34 : m.y - 20}
        text-anchor={m.flip ? "end" : "start"}
        class="scen__tag"
      >
        {m.tag.toUpperCase()}
      </text>
    </g>
  ))}
</svg>

<style>
  .scen {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .scen__rect {
    fill: var(--signal);
    fill-opacity: 0.04;
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .scen__name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .scen__no {
    fill: var(--signal-text);
  }
  .scen__key {
    font-family: var(--font-text);
    font-size: 13px;
    fill: var(--graphite);
  }
  .scen__path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linejoin: miter;
  }
  .scen__mark {
    fill: var(--ink);
  }
  .scen__n {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    fill: var(--paper);
  }
  .scen__tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scen__path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 2600ms var(--ease-draw) 200ms;
    }
    :global(.js) .scen.is-in .scen__path {
      stroke-dashoffset: 0;
    }
    :global(.js) .scen__step {
      opacity: 0;
      transition: opacity 400ms var(--ease-out);
      transition-delay: calc(250ms + var(--n) * 360ms);
    }
    :global(.js) .scen.is-in .scen__step {
      opacity: 1;
    }
  }
</style>
