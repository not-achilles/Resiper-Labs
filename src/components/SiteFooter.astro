---
import { company, footer, nav } from "../content/site";
import OwnerPending from "./OwnerPending.astro";
import { url } from "../lib/url";

// The footer is the site's only contact point: there is no separate Contact
// section (owner decision, 2026-10-10). Nav "Contact" links land here.
const year = new Date().getFullYear();
---

<footer class="colophon" id="contact" aria-labelledby="contact-title">
  <div class="page">
    <h2 id="contact-title" class="colophon__close display">
      {footer.closing}
    </h2>

    <div class="grid colophon__grid">
      <dl class="colophon__facts">
        <div>
          <dt class="mono-s muted">Company</dt>
          <dd>{company.legalName}</dd>
        </div>
        <div>
          <dt class="mono-s muted">Registered office</dt>
          <dd>{company.registeredOffice ?? <OwnerPending what="registered office address" />}</dd>
        </div>
        <div>
          <dt class="mono-s muted">Email</dt>
          <dd>
            <ul class="colophon__list">
              {company.emails.map((e) => (
                <li>
                  <a class="link" href={`mailto:${e.address}`}>
                    {e.address}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
        <div>
          <dt class="mono-s muted">Phone</dt>
          <dd>
            <ul class="colophon__list">
              {company.phones.map((ph) => (
                <li>
                  <a class="link" href={`tel:${ph.tel}`}>
                    {ph.display}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <nav class="colophon__nav" aria-label="Footer">
        <ul>
          {nav.map((item) => (
            <li>
              <a class="link" href={url(item.href)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="colophon__base mono-s muted">
      <span>
        © {year} {company.legalName}
      </span>
      <span>
        Data management · Consolidation · Data platforms · Semantic layer · AI on data · IoT
      </span>
    </div>
  </div>
</footer>

<style>
  .colophon {
    margin-block-start: var(--section-gap);
    padding-block-end: var(--s-7);
  }

  /* Closing statement: a quiet sign-off on the same ink rule as every section */
  .colophon__close {
    padding-block-start: var(--s-6);
    border-block-start: var(--hair) solid var(--ink);
    margin: 0;
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: -0.028em;
    font-weight: 330;
  }

  .colophon__grid {
    margin-block-start: var(--s-8);
    row-gap: var(--s-7);
    align-items: start;
  }

  .colophon__facts {
    grid-column: 1 / span 8;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--gutter);
    font-size: var(--fs-small);
  }
  .colophon__facts dd {
    margin: var(--s-1) 0 0;
  }
  .colophon__list {
    display: grid;
    gap: var(--s-1);
    justify-items: start;
  }
  .colophon__list a {
    overflow-wrap: anywhere;
  }

  .colophon__nav {
    grid-column: 10 / -1;
  }
  .colophon__nav ul {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .colophon__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-3);
    border-block-start: var(--hair) solid var(--rule);
  }

  @media (max-width: 47.99em) {
    .colophon__facts {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr);
    }
    .colophon__nav {
      grid-column: 1 / -1;
    }
  }
</style>
