---
/**
 * Client reference. Leadership-approved (2026-09-28): the client may be
 * named; owner approved the logo in place of the text (2026-10-14).
 * Logo only (the "A" emblem, shown in the client's own colours at the owner's
 * request): no scope, metrics or quote.
 */
import apolloLogo from "../assets/clients/apollo-tyres.png";
import { clients } from "../content/site";
import SectionRule from "./SectionRule.astro";
---

<section
  id="clients"
  class="section clients"
  data-section="08"
  data-label="Client"
  aria-labelledby="clients-title"
>
  <div class="page">
    <SectionRule no="08" title="Client reference" aside={clients.note} />
    <div class="grid clients__body">
      <h2 id="clients-title" class="mono clients__k">
        {clients.label}
      </h2>
      <ul class="clients__list">
        {clients.names.map((n) => (
          <li class="clients__name" data-reveal>
            <img
              class="clients__logo"
              src={apolloLogo.src}
              width={apolloLogo.width}
              height={apolloLogo.height}
              alt={n}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .clients__body {
    margin-block-start: var(--s-7);
    align-items: center;
    row-gap: var(--s-3);
  }
  .clients__k {
    grid-column: 1 / span 3;
    font-weight: 400;
    color: var(--graphite);
  }
  .clients__list {
    grid-column: 4 / -1;
  }
  .clients__logo {
    display: block;
    inline-size: 8rem;
    max-inline-size: 100%;
    block-size: auto;
  }
  @media (max-width: 47.99em) {
    .clients__k,
    .clients__list {
      grid-column: 1 / -1;
    }
  }
</style>
