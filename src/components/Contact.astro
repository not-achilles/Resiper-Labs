---
import { company, contact } from "../content/site";
import SectionRule from "./SectionRule.astro";
---

<section
  id="contact"
  class="section contact"
  data-section="09"
  data-label="Contact"
  aria-labelledby="contact-title"
>
  <div class="page">
    <SectionRule no="09" title="Contact" aside={company.legalName} />

    <div class="grid contact__body">
      <h2 id="contact-title" class="display contact__title" data-reveal>
        {contact.heading}
      </h2>
      <p class="contact__text" data-reveal style="--reveal-i:1">
        {contact.text}
      </p>

      <div class="contact__channel" data-reveal style="--reveal-i:2">
        <dl class="contact__lines">
          {company.emails.map((e, i) => (
            <div class:list={["contact__line", i === 0 && "contact__line--lead"]}>
              <dt class="mono-s muted">{e.label}</dt>
              <dd>
                <a class="contact__email display" href={`mailto:${e.address}`}>
                  {e.address}
                </a>
              </dd>
            </div>
          ))}
          <div class="contact__line">
            <dt class="mono-s muted">Phone</dt>
            <dd class="contact__phones">
              {company.phones.map((ph) => (
                <a class="link contact__tel" href={`tel:${ph.tel}`}>
                  {ph.display}
                </a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__body {
    margin-block-start: var(--s-8);
    row-gap: var(--s-7);
  }
  .contact__title {
    grid-column: 1 / span 10;
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: -0.028em;
    font-weight: 330;
  }
  .contact__text {
    grid-column: 7 / span 5;
    color: var(--graphite);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
  .contact__channel {
    grid-column: 7 / -1;
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    padding-block-start: var(--s-4);
    border-block-start: var(--hair) solid var(--ink);
  }
  .contact__lines {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }
  .contact__line {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--gutter);
  }
  .contact__line dd {
    margin: 0;
  }
  .contact__email {
    font-size: var(--fs-display-s);
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--rule-strong), var(--rule-strong));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% var(--hair);
  }
  .contact__line--lead .contact__email {
    font-size: var(--fs-display-m);
    letter-spacing: -0.02em;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-size: 100% 2px;
  }
  .contact__email:hover,
  .contact__email:focus-visible {
    background-image: linear-gradient(var(--signal), var(--signal));
  }
  .contact__phones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
  }
  .contact__tel {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 47.99em) {
    .contact__title,
    .contact__text,
    .contact__channel {
      grid-column: 1 / -1;
    }
    .contact__line {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }
</style>
