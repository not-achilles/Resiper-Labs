---
import { principles } from "../content/site";
import SectionRule from "./SectionRule.astro";
---

<section
  id="principles"
  class="section principles"
  data-section="04"
  data-label="Engineering principles"
  aria-labelledby="principles-title"
>
  <div class="page">
    <SectionRule no="04" title="Engineering principles" aside="Applies in every area" />

    <div class="grid principles__intro">
      <p class="mono-s muted principles__applies" aria-hidden="true">
        Scope
        <br />
        All six areas
        <br />
        01 — 06
      </p>
      <h2 id="principles-title" class="display principles__title" data-reveal>
        Five rules we engineer by.
      </h2>
    </div>

    <ol class="rules">
      {principles.map((p, i) => (
        <li class="grid rule" data-reveal style={`--reveal-i:${i % 3}`}>
          <span class="rule__no mono" aria-hidden="true">
            R—{p.no}
          </span>
          <h3 class="rule__statement display">{p.rule}</h3>
          <p class="rule__text">{p.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .principles__intro {
    margin-block: var(--s-8);
    align-items: end;
    row-gap: var(--s-4);
  }
  .principles__applies {
    grid-column: 1 / span 2;
    border-inline-start: var(--hair) solid var(--signal);
    padding-inline-start: var(--s-3);
  }
  .principles__title {
    grid-column: 3 / span 8;
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: -0.025em;
    font-weight: 340;
  }

  .rules {
    counter-reset: rule;
  }
  .rule {
    align-items: baseline;
    row-gap: var(--s-3);
    padding-block: var(--s-6);
    border-block-start: var(--hair) solid var(--rule);
  }
  .rule:last-child {
    border-block-end: var(--hair) solid var(--rule);
  }
  .rule__no {
    grid-column: 1 / span 2;
    color: var(--signal-text);
  }
  .rule__statement {
    grid-column: 3 / span 5;
    font-size: var(--fs-display-s);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  .rule__text {
    grid-column: 8 / span 4;
    color: var(--graphite);
    font-size: var(--fs-small);
    max-width: 44ch;
  }

  @media (max-width: 63.99em) {
    .rule__statement {
      grid-column: 3 / -1;
    }
    .rule__text {
      grid-column: 3 / span 8;
    }
  }

  @media (max-width: 47.99em) {
    .principles__applies {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .principles__title {
      grid-column: 1 / -1;
    }
    .rule__no {
      grid-column: 1 / -1;
    }
    .rule__statement,
    .rule__text {
      grid-column: 1 / -1;
    }
  }
</style>
